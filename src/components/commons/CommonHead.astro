---
import { ClientRouter } from "astro:transitions";
import { locales, type Locale } from "../../i18n/config";
import { assetPath, localizedPath, type RouteId } from "../../i18n/routes";

interface Props {
  lang: Locale;
  currentRoute: RouteId;
}
const { lang, currentRoute } = Astro.props;

const meta = {
  es: {
    title: "Bernardo Ramírez — Desarrollador full-stack",
    description:
      "Portfolio de Bernardo Ramírez, desarrollador full-stack con siete años de experiencia construyendo productos web, APIs y soluciones móviles.",
  },
  en: {
    title: "Bernardo Ramírez — Full-Stack Developer",
    description:
      "Portfolio of Bernardo Ramírez, a full-stack developer with seven years of experience building web products, APIs, and mobile solutions.",
  },
};

const { title, description } = meta[lang];
const canonicalUrl = new URL(
  localizedPath(lang, currentRoute),
  Astro.site ?? Astro.url,
);
---

<link rel="icon" type="image/svg+xml" href={assetPath("favicon.svg")} />
<link rel="canonical" href={canonicalUrl} />
{
  locales.map((locale) => (
    <link
      rel="alternate"
      hreflang={locale}
      href={
        new URL(localizedPath(locale, currentRoute), Astro.site ?? Astro.url)
      }
    />
  ))
}

<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<ClientRouter />
